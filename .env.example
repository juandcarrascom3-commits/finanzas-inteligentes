# FINANCE local configuration template.
# Copy this file to `.env` and edit locally. `.env` is gitignored and must never be committed.
# Process environment variables always override values loaded from `.env`.
# Leave secret values empty until you really need them.

# Local SQLite database. Relative paths resolve from the repository root.
FINANCE_DB_PATH=database/finance.local.db
# Seed demo data into an empty database: 1 = yes (demo), 0 = no (real/empty personal data).
FINANCE_SEED_DEMO=0

# Browser origins allowed to call the local API.
FINANCE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Wallet by BudgetBakers (read-only). Keep the token empty when unused.
BUDGETBAKERS_API_TOKEN=
BUDGETBAKERS_BASE_URL=https://rest.budgetbakers.com/wallet

# eToro import. Keep the keys empty when unused.
ETORO_API_KEY=
ETORO_USER_KEY=
ETORO_BASE_URL=https://public-api.etoro.com/api/v1
ETORO_ENVIRONMENT=demo
